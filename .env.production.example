# 复制为 .env.production 并填入真实值
# 访问口令（浏览器首次打开会要求输入，建议设一个复杂点的）
ACCESS_TOKEN=change-me-to-a-strong-token

# 模型配置
LLM_MODEL_ID=qwen-plus
LLM_API_KEY=sk-your-qwen-key
# 国际版 key（sk-ws- 开头）用国际端点；国内版 key 用 https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
